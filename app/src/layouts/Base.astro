---
import { Font } from 'astro:assets';
import { pwaInfo } from 'virtual:pwa-info';
import '../styles/global.css';
import { t, switchPath, otherLang, languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** absolute or root-relative path to a 1200x630 PNG */
  ogImage?: string;
}
const { lang, title, description, ogImage = '/og/default.png' } = Astro.props;
const tr = t(lang);
const path = Astro.url.pathname;
const site = Astro.site!;
const fullTitle = title ? `${title} · ${tr('site.title')}` : tr('site.title');
const desc = description ?? tr('site.tagline');
const canonical = new URL(path, site).href;
const other = otherLang(lang);
const nav = [
  { href: `/${lang}/`, label: tr('nav.home') },
  { href: `/${lang}/names/`, label: tr('nav.names') },
  { href: `/${lang}/chant/`, label: tr('nav.chant') },
  { href: `/${lang}/calendar/`, label: tr('nav.calendar') },
];
const more = [
  { href: `/${lang}/sit/`, label: tr('nav.sit') },
  { href: `/${lang}/visit/`, label: tr('nav.visit') },
  { href: `/${lang}/offerings/`, label: tr('nav.offerings') },
  { href: `/${lang}/yantra/`, label: tr('nav.yantra') },
  { href: `/${lang}/isha/`, label: tr('nav.isha') },
  { href: `/${lang}/my-story/`, label: tr('nav.story') },
];
---
<!doctype html>
<html lang={lang === 'ta' ? 'ta' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {Object.keys(languages).map((l) => <link rel="alternate" hreflang={l} href={new URL(switchPath(path, l as Lang), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(switchPath(path, 'en'), site).href} />
    <meta name="theme-color" content="#0e0a09" />
    <script is:inline>
      try { var r = document.documentElement, s = localStorage.getItem('lb.scale'); if (s) r.dataset.scale = s; if (localStorage.getItem('lb.light') === '1') r.dataset.light = ''; } catch (e) {}
    </script>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <Fragment set:html={pwaInfo?.webManifest.linkTag} />
    <Font cssVariable="--font-tamil" preload={lang === 'ta'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={tr('site.title')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ta' ? 'ta_IN' : 'en_IN'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">{tr('nav.skip')}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={`/${lang}/`}>{tr('site.title')}</a>
        <div class="tools">
          <button type="button" class="tool" data-scale-step="-1" aria-label={tr('elder.smaller')} title={tr('elder.smaller')}>A−</button>
          <button type="button" class="tool" data-scale-step="1" aria-label={tr('elder.larger')} title={tr('elder.larger')}>A+</button>
          <button type="button" class="tool" data-light-toggle aria-pressed="false" aria-label={tr('elder.light')} title={tr('elder.light')}>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg>
          </button>
          <a class="tool lang" href={switchPath(path, other)} hreflang={other} lang={other}>{tr('nav.lang')}</a>
        </div>
      </div>
      <nav class="wrap" aria-label="Main">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
          <li>
            <details class="more">
              <summary>{tr('nav.more')}</summary>
              <ul>
                {more.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
              </ul>
            </details>
          </li>
        </ul>
      </nav>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="wrap muted small">
      <ul class="foot-links">
        {[...nav, ...more].map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
      <p>{tr('footer.isha')}</p>
      <p id="offline-ready" hidden>{tr('offline.ready')}</p>
    </footer>
    <script is:inline define:vars={{ lang }}>
      try { if (location.pathname !== '/') localStorage.setItem('lb.lang', lang); } catch (e) {}
    </script>
    <script>
      // Elder mode: A− / A+ and reading light, remembered on this phone.
      const root = document.documentElement;
      const lightBtn = document.querySelector<HTMLButtonElement>('[data-light-toggle]');
      const sync = () => lightBtn?.setAttribute('aria-pressed', String(root.hasAttribute('data-light')));
      document.querySelectorAll<HTMLButtonElement>('[data-scale-step]').forEach((b) =>
        b.addEventListener('click', () => {
          const v = Math.max(0, Math.min(3, Number(root.dataset.scale ?? 0) + Number(b.dataset.scaleStep)));
          if (v) root.dataset.scale = String(v); else delete root.dataset.scale;
          try { localStorage.setItem('lb.scale', String(v)); } catch {}
        }),
      );
      lightBtn?.addEventListener('click', () => {
        root.toggleAttribute('data-light');
        try { localStorage.setItem('lb.light', root.hasAttribute('data-light') ? '1' : '0'); } catch {}
        sync();
      });
      sync();
    </script>
    <script>
      import { registerSW } from 'virtual:pwa-register';
      registerSW({
        immediate: true,
        onOfflineReady() {
          document.getElementById('offline-ready')?.removeAttribute('hidden');
        },
      });
    </script>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--line); }
  .site-header { border-top: 3px solid var(--kumkum); }
  .bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-1) var(--space-2); min-height: 3.5rem; padding-top: var(--space-1); }
  .brand { font-weight: 600; font-size: 1.25rem; color: var(--ink); text-decoration: none; }
  .tools { display: flex; gap: 0.375rem; align-items: center; }
  .tool { font-family: var(--font-ui); display: inline-flex; align-items: center; justify-content: center; min-height: var(--tap); min-width: var(--tap); padding: 0 0.625rem; border: 1px solid var(--line); border-radius: var(--radius); background: transparent; color: var(--accent); text-decoration: none; font-size: 1.05rem; }
  .tool[aria-pressed='true'] { background: var(--accent); color: var(--accent-ink); }
  nav ul { list-style: none; display: flex; flex-wrap: wrap; align-items: flex-start; gap: 0 var(--space-2); padding: 0; margin: 0 0 var(--space-1); }
  nav a, summary { display: inline-flex; align-items: center; min-height: var(--tap); font-family: var(--font-ui); }
  summary { color: var(--accent); cursor: pointer; text-decoration: underline; text-underline-offset: 0.2em; }
  .more[open] ul { display: grid; position: absolute; z-index: 5; background: var(--bg-raised); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-1) var(--space-2); margin-top: 0.25rem; gap: 0; }
  .foot-links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--space-2); }
  .foot-links a { display: inline-flex; align-items: center; min-height: var(--tap); }
  nav a[aria-current='page'] { color: var(--ink); text-decoration-thickness: 3px; }
  footer { margin-top: var(--space-4); padding-block: var(--space-3); border-top: 1px solid var(--line); }
</style>
